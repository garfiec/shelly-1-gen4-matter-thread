# Build output
build/
sdkconfig
sdkconfig.old
read-partition-table.bin
.cache/

# Managed components — downloaded automatically, not committed
managed_components/

# macOS
.DS_Store
**/.DS_Store

# VSCode — personal settings stay local, but the extension recommendation
# that bootstraps the dev container is shared.
.vscode/*
!.vscode/extensions.json

# Python cache
__pycache__/
*.pyc
*.pyo

# esptool temp files
*.log

# Sensitive — never commit original firmware backup
shelly-*-gen4-stock-*.bin

# Sensitive — a stock device capture (scripts/capture-shelly-webui.py) holds
# its identity and configuration
shelly-capture-*

# Claude Code worktrees
.claude/worktrees/

# Release binaries, zip, ota — these go in GitHub Releases
automatous-io-shelly-*-gen4-*.bin
automatous-io-shelly-*-gen4-*.zip
automatous-io-shelly-*-gen4-*.ota

# IDF component manager
idf_component_manager.yml
.idf_component_manager/
# Captures of a stock Shelly (scripts/capture-shelly-webui.py): device-specific, include its Matter setup code
shelly-capture-*

# Diagnostics builds (docs/BUILDING.md)
build_diag/
sdkconfig.diag
