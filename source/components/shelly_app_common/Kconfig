menu "Shelly diagnostics"

    config SHELLY_DIAG_LOG
        bool "Diagnostics log on the Wi-Fi mode page"
        default n
        help
            Keep the last 6 KB of the log in memory that survives a restart,
            and show it on the Wi-Fi maintenance page (Diagnostics log). It
            also logs heap and Thread/IP state every few seconds while pairing,
            and freezes the log 5 s after a failed pairing. Costs 6 KB of heap
            for the whole run. For troubleshooting builds only: see docs/BUILDING.md.

endmenu

menu "Shelly device type"

    # What the relay can be for, chosen on the Wi-Fi mode page
    # (device_profile.h). A build without Wi-Fi mode is always its default
    # type. One build per device is packaged once per Matter Product ID, each
    # with that product line's type as the default.

    config SHELLY_TYPE_OUTLET
        bool "Offer Outlet (On/Off Plug-in Unit)"
        default y

    config SHELLY_TYPE_LIGHT
        bool "Offer Light (On/Off Light)"
        default n

    config SHELLY_TYPE_OPENER
        bool "Offer Garage door opener (a toggle is a pulse)"
        default n
        help
            For a relay with a dry contact only.

    config SHELLY_OPENER_CONTACT_SENSOR
        bool "The Opener reads a door contact sensor on SW"
        depends on SHELLY_TYPE_OPENER
        default n
        help
            The Shelly 1 Gen4 Opener: SW is a door sensor, reported as a Matter
            Contact Sensor endpoint, and never switches the relay. Without it
            (a mains-powered board, whose SW carries mains voltage) the Opener
            has the Outlet's endpoints and the wall switch modes.

    config SHELLY_TYPE_LIGHT_SWITCH
        bool "Offer Light Switch (SW drives bound lights)"
        default n

    choice SHELLY_DEFAULT_TYPE
        prompt "Default device type"
        default SHELLY_DEFAULT_TYPE_OUTLET
        help
            The type of a device with none saved: a fresh install, or one
            updated from a build of a single type (this product line's).

        config SHELLY_DEFAULT_TYPE_OUTLET
            bool "Outlet"
            depends on SHELLY_TYPE_OUTLET
        config SHELLY_DEFAULT_TYPE_LIGHT
            bool "Light"
            depends on SHELLY_TYPE_LIGHT
        config SHELLY_DEFAULT_TYPE_OPENER
            bool "Garage door opener"
            depends on SHELLY_TYPE_OPENER
        config SHELLY_DEFAULT_TYPE_LIGHT_SWITCH
            bool "Light Switch"
            depends on SHELLY_TYPE_LIGHT_SWITCH
    endchoice

    config SHELLY_PULSE_MS
        int "Opener pulse length (ms)"
        depends on SHELLY_TYPE_OPENER
        default 500
        range 100 5000
        help
            How long the relay stays closed for one trigger in opener mode.

endmenu
